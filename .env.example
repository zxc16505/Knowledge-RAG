# ===== 知识库演示部署环境变量（复制为 .env 后修改） =====

# 所有 API 接口的鉴权密钥（必改，建议 32 位随机串：openssl rand -hex 16）
API_GLOBAL_KEY=change_me_to_a_long_random_string

# Gitea Webhook 签名密钥（必改，与 gitea 服务保持一致）
WEBHOOK_SECRET=change_me_to_another_random_string

# 飞书事件订阅 Encrypt Key（必改）
# 用于 /feishu/event 验签：SHA256(timestamp + nonce + encrypt_key + body) == X-Lark-Signature
# 演示环境可自行生成随机串，配合 feishu_demo 的 mock 脚本即可复现安全用例
FEISHU_ENCRYPT_KEY=change_me_to_feishu_encrypt_key

# ===== 接真实飞书：把答案回给提问人 =====
# 飞书自建应用凭证（开放平台 -> 凭证与基础信息）
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
# 是否把检索结果回复给提问人（默认开）
FEISHU_REPLY_ENABLED=true

# ===== 可选：用大模型生成答案（OpenAI 兼容接口，DeepSeek / Qwen 等）=====
# 三项都填才启用；不填则回检索到的原文片段
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 离线向量模型路径（容器内；./models 不存在时自动降级关键词检索）
EMBED_MODEL_PATH=/models/BAAI/bge-base-zh-v1.5
